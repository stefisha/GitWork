# Backend settings. Never commit .env or place server secrets in VITE_* variables.
NODE_ENV=development
PORT=3000
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
AUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
CLAIM_BASE_URL=http://localhost:3000
# PRIVY_APP_ID is used by wallet services; NEXT_PUBLIC_PRIVY_APP_ID is also
# read by the historical config module. Set both to your own application ID.
PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_FEE_PAYER_PRIVATE_KEY=
PLATFORM_FEE_PERCENTAGE=0
PLATFORM_REVENUE_WALLET=
DISCORD_WEBHOOK_URL=
